{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "inherit"
  },
  "permissions": {
    "allow": [
      "Bash(echo \\\\n# Alias for claude --dangerously-skip-permissions\\\\nclaude-bah\\(\\) { claude --dangerously-skip-permissions \"\"$@\"\"; }:*)",
      "Bash(zoxide init:*)",
      "Bash(source:*)",
      "Bash(zsh:*)",
      "Bash(echo:*)",
      "Bash(brew cleanup:*)"
    ],
    "deny": [
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "defaultMode": "bypassPermissions"
  },
  "disableBundledSkills": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/plan-review.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/zackbart/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/agent-plugins/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $(0) }'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"/opt/homebrew/bin/nub\" \"${plugin_dir}src/index.ts\"'"
  },
  "enabledPlugins": {
    "claude-hud@agent-plugins": true,
    "context7@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "agent-plugins": {
      "source": {
        "source": "github",
        "repo": "zackbart/agent-plugins"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}
